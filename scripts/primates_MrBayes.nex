#NEXUS

[Data source: https://revbayes.github.io/tutorials/ctmc/]

BEGIN DATA;
DIMENSIONS  NTAX=23 NCHAR=1102;
FORMAT DATATYPE=DNA GAP=- MISSING=?;
MATRIX

Saimiri_sciureus               -
Callicebus_donacophilus        -
Cebus_albifrons                ---AATTCCTCTATCAGCCCTAACTGAAAATAAGCTACTTAAA-
Aotus_trivirgatus              -
Hylobates_lar                  
Pan_paniscus                   
Colobus_guereza                
Chlorocebus_aethiops           
Macaca_mulatta                 
Tarsius_syrichta               -
Galago_senegalensis            -
Otolemur_crassicaudatus        -
Perodicticus_potto             -
Loris_tardigradus              -
Nycticebus_coucang             -
Daubentonia_madagascariensis   -
Lepilemur_hubbardorum          -
Varecia_variegata_variegata    -
Microcebus_murinus             -
Cheirogaleus_major             -
Propithecus_coquereli          -
Lemur_catta                    -
Galeopterus_variegatus         ----------------------------------------------------------------
;

END;

begin mrbayes;

[Prior on the tree topology and branch lengths]
prset topologypr = uniform;
prset brlenspr = unconstrained:exp(10.0);

[The JC model]
[lset nst = 1; [number of rate categories]
prset statefreqpr = fixed(equal);]

[The GTR model]
lset nst = 6; [number of rate categories]
prset statefreqpr = Dirichlet(1.0,1.0,1.0,1.0);

[Among site rate variation]
lset rates = equal; [assume rates are also constant across sites]

[MCMC settings]
[JC]
[mcmc ngen = 200000 samplefreq = 100 printfreq = 100 nchains = 1 filename = /Users/iq75aqot/Documents/MrBayes_exercise/primates_JC;]
[GTR]
mcmc ngen = 200000 samplefreq = 100 printfreq = 100 nchains = 1 filename = /Users/iq75aqot/Documents/MrBayes_exercise/primates_GTR;
sumt;

end;